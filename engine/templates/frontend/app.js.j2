    // 字段是跨界面状态，不该被一次提交抹掉。
    function clearFields(name) {
      const paths = clears[name];
      if (!paths) return;
      const state = forms.value[current.value.name];
      const blankState = blank[current.value.name] || {};
      for (const p of paths) {
        const parts = p.split(".");
        let node = state, src = blankState;
        for (const k of parts.slice(0, -1)) {
          node = node && node[k]; src = src && src[k];
        }
        const last = parts[parts.length - 1];
        if (node) node[last] = (src && last in src) ? JSON.parse(JSON.stringify(src[last])) : "";
