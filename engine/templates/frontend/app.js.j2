    // 这一页的端，已经送走或拒了（见 checkEnd）
    async function refreshMe(fresh) {
      try {
        const r = await fetch(endpoints.auth_me, { method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ action: "auth_me", form: {} }) });
