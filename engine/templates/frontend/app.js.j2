      return path.split(".").reduce((o, k) => (o == null ? o : o[k]), obj);
    }
<% endif %>
    // 能不能当链接地址：只认站内 # 地址和 http(s)，别的（javascript: 之类、
    // 空的）不画。「链接」和列的「地址」都用它。
    function isHref(v) {
