    function applyResponse(resp) {
      if (!resp) return;
<% if i18n_langs %>
      // 后端消息按当前语言替换（整串查词典，缺失回退中文）。数据（state、
      // lists 里的行）不在这里翻——状态枚举被「当」条件比较，动了会出错。
      if (Array.isArray(resp.messages)) {
        resp.messages = resp.messages.map(m => Object.assign({}, m, { who: tmsg(m.who), text: tmsg(m.text) }));
      }
      if (resp.error) resp.error = tmsg(resp.error);
<% endif %>
      if (resp.state && typeof shared !== "undefined") Object.assign(shared.value, resp.state);
