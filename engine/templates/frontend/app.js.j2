<% from "layout.j2" import 节点 with context %>
{#- 这几个默认值是必需的：StrictUndefined 开着，没走某条路的调用方
    会直接报 undefined 而不是静默渲染成空。 -#}
<% set has_shared_state = has_shared_state if has_shared_state is defined else false %>
<% set has_endpoints = has_endpoints if has_endpoints is defined else false %>
<% set has_to_actions = has_to_actions if has_to_actions is defined else false %>
<% set has_goto = has_goto if has_goto is defined else false %>
<% set has_overlays = has_overlays if has_overlays is defined else false %>
<% set has_enter = has_enter if has_enter is defined else false %>
<% if shared_json is not defined %><% set shared_json = "{}" %><% endif %>
<% if endpoints_json is not defined %><% set endpoints_json = "{}" %><% endif %>
<% if clears_json is not defined %><% set clears_json = "{}" %><% endif %>
{#- 科目切换器（顶栏下拉）：项目声明了动作 subject_switch（远程端点里有它）且开着 auth_me
    才生成。没声明的项目（现有的 kg、kg_v4）一行相关代码都不生成。 -#}
<% set has_subject_switch = (has_me is defined and has_me and '"subject_switch"' in endpoints_json) %>
<% if echoes_json is not defined %><% set echoes_json = "{}" %><% endif %>
<% if screen_streams_json is not defined %><% set screen_streams_json = "{}" %><% endif %>
<% if file_fields_json is not defined %><% set file_fields_json = "{}" %><% endif %>
<% if lists_init_json is not defined %><% set lists_init_json = "{}" %><% endif %>
<% if loaders_json is not defined %><% set loaders_json = "{}" %><% endif %>
<% if overlay_loaders_json is not defined %><% set overlay_loaders_json = "{}" %><% endif %>
<% if triggers_json is not defined %><% set triggers_json = "{}" %><% endif %>
<% if enter_json is not defined %><% set enter_json = "{}" %><% endif %>
<% if nav_json is not defined %><% set nav_json = "[]" %><% endif %>
<% if page_json is not defined %><% set page_json = '{"end": "", "main": true, "role": "", "badge": "", "ends": {}, "home": null, "elsewhere": {}}' %><% endif %>
<% set nav = nav if nav is defined else false %>
<% set nav_sides = nav_sides if nav_sides is defined else [] %>
<% set has_poll = has_poll if has_poll is defined else false %>
<% set has_row_remote = has_row_remote if has_row_remote is defined else false %>
<% set has_msg_actions = has_msg_actions if has_msg_actions is defined else false %>
<% if stream_actions_json is not defined %><% set stream_actions_json = "{}" %><% endif %>
<% set nav_logout = nav_logout if nav_logout is defined else false %>
<% set has_me = has_me if has_me is defined else false %>
<% set has_logout = has_logout if has_logout is defined else false %>
<% set has_files = file_fields_json != "{}" %>
<% set has_graphs = has_graphs if has_graphs is defined else false %>
<% set i18n_langs = i18n_langs if i18n_langs is defined else [] %>
<% set has_lang_switch = has_lang_switch if has_lang_switch is defined else false %>
const { createApp, ref, computed } = Vue;
const screens = <%= screens_json %>;
{#- 每个界面一份表单状态，按界面名索引。共用一个对象会让同名字段串味，
    切界面也会残留上一个界面填过的值。浮层里的字段也在这里——浮层属于
    它所在的界面。文件字段不在这里，见下面的 files。 -#}
const blank = <%= form_defaults_json %>;
// 动作名 -> 提交成功后要清空的字段路径（.ui 里标了「清空」的动作）。
// 旧版发完消息会立刻清空输入框；这是那条行为的一般化，范围限定在动作
// 所在的那个容器，免得把练习页的课程、考点选择也一起抹掉。
const clears = <%= clears_json %>;
// 动作名 -> 发请求前要本地回显进消息流的字段路径（.ui 里标了「回显」）。
// 旧版发消息时先 add('你', text) 再发请求，自己说的话立刻出现；等后端
// 回传的话，接真模型要等好几秒，中间只有一个「…」。
// 注意：标了回显就别让后端再回一遍同样的内容，否则会出现两条。
const echoes = <%= echoes_json %>;
// 界面名 -> 这个界面的消息流。回显、占位、后端返回都要落到当前界面那条。
// 早先这三处都用全局第一条流：在练习页提交时，占位「…」被塞进对话页的
// chat，而后端返回 stream:"drill" 把真消息放进 drill——占位永远留在 chat
// 里清不掉，练习页什么都看不见。跟 submit_action 当初那个 bug 同形：
// 全局取第一个，换了界面就打到别人身上，而且不报错。
const screenStream = <%= screen_streams_json %>;
// 动作名 -> 界面名，标了「进入时」的动作：每次进入那个界面自动跑一次，
// 打开就有数据，不用先点一下刷新。
const enterActions = <%= enter_json %>;
// 界面名 -> 带着地址参数进来时用哪个接口把记录拉回来（.ui 里的「载入」）
const loaders = <%= loaders_json %>;
// 浮层名 -> 同上，浮层上的「载入」
const overlayLoaders = <%= overlay_loaders_json %>;
// 界面名 -> 带着地址参数进来时跑一次的动作（.ui 里的「触发」）
const triggers = <%= triggers_json %>;
// 这一页是哪一端。界面写了不同的「端」时，引擎按端拆成几个页面、各一个地址
// （学生 /、教师 /teacher，见 gen/project.py 的 split_pages），每页只有自己那
// 一端的界面：
//   end        这一页的端；main 是不是主页面（/）
//   badge      顶栏最前面的标识（「教师端」），role 是页面代号（nav-role-<代号>）
//   ends       {端名或角色代号: 地址}：登录的人是别的端的，往哪儿送
//   home       非主页面顶栏上「打开学生端」的链接
//   elsewhere  {界面名: 端名}：别的页面上的界面，地址里打了它不进、提示在哪一端
// 没拆的应用 end 是空串、ends 是空的，下面这些一概不起作用。
const PAGE = <%= page_json %>;
// 顶部导航：[{label, target, group}]。group 是同属一个实体的几个界面名，
// 在其中任何一个上时那一项高亮。由项目编译时算好传进来。
const nav = <%= nav_json %>;
<% if has_files %>
// 界面名 -> 该界面的文件字段。有文件的界面提交走 FormData，没有的发 JSON。
const fileFields = <%= file_fields_json %>;
<% endif %>
<% if has_endpoints %>
// 动作名 -> 后端端点。这个常量之前漏了声明，onAction 里裸引用直接
// ReferenceError；submitTo 里当时的 typeof 守卫更糟——不报错，只是永远
// 走 fallback，看着像"后端没接上"而不是"代码有 bug"。
const endpoints = <%= endpoints_json %>;
// 一个请求最多等多久（毫秒），见 postTo
const FETCH_TIMEOUT_MS = 240000;
<% endif %>

const _app = createApp({
  setup() {
    // 地址：#界面名?参数=值。界面名用 encodeURIComponent 编过（名字里的
    // 「?」会变成 %3F），所以裸的「?」一定是分隔符。
    //   #笔记列表?浮层=笔记&id=5   刷新、把地址发给别人，都还知道是哪一条
    function parseHash() {
      const raw = location.hash.replace(/^#\/?/, "");
      const cut = raw.indexOf("?");
      const name = decodeURIComponent(cut < 0 ? raw : raw.slice(0, cut));
      const params = cut < 0 ? {} : Object.fromEntries(new URLSearchParams(raw.slice(cut + 1)));
      return [name || screens[0].name, params];
    }
    const route = ref(parseHash()[0]);
    const params = ref(parseHash()[1]);
    const forms = ref(JSON.parse(JSON.stringify(blank)));
    // 表格数据，按列表的数据键分开存（数据键默认是表名，「绑」能另指一个）。
    // 接口用 lists 按键给：{"prereq": …, "children": …}。
    //
    // 早先是一个全局的 rows，一个界面就只能有一张表——「知识点全貌」那种
    // 要同时显示前置、后续、挂着的词的页面根本做不了。
    //
    // 初值是编译时塞的示例数据，给没有后端的预览用。
    const lists = ref(<%= lists_init_json %>);
    // 列表的数据：先看后端返回的 lists 里这个键有没有数据；没有就把键当成共享
    // 状态的路径去读。节点图详情浮层里的「列表 包含 绑 sel.points」读的就是
    // 选中节点身上的数组——那份数据跟着节点来，不走 lists。
    // lists 优先：两边都有时，接口明确给的那份算数。
    const rowsOf = name => {
      const v = lists.value[name];
      if (v && v.length) return v;
      if (typeof shared !== 'undefined') {
        const w = name.split('.').reduce((o, k) => (o == null ? o : o[k]), shared.value);
        if (Array.isArray(w)) return w;
      }
      return v || [];
    };
    // 请求期间禁用提交按钮：旧版有 send.disabled，少了它连点会重复发。
    //
    // 按界面记（界面名 -> 正在请求的动作名），busy / pending 只看当前界面。
    // 早先全站一个开关：做题页「请老师总结」要等十几秒，这段时间切到问老师，
    // 发送按钮是灰的、按 Enter 没反应，整个站看着像卡住了（用户反馈过）。
    const inflight = ref({});
    const busy = computed(() => !!inflight.value[current.value.name]);
    // 正在请求的是哪个动作（没有就是空串）。慢的接口（调模型的）在 .ui 里
    // 按它显示等待的话：文案 当 pending==='quiz_summary' 老师正在看…
    // 只看 busy 的话，同一处点别的按钮也会闪出那句话。
    const pending = computed(() => inflight.value[current.value.name] || "");
    // 界面底部的一条提示，几秒后自己消失，点一下也能关。给没有消息流的
    // 界面用：保存成功、后端报错，总得让人看见。出错的留久一点。
    //
    // 放在所有条件块外面：下面的 return 无条件导出 notice，定义在
    // has_endpoints 里的话，没有后端的界面（编辑器预览）直接白屏。
    const notice = ref(null);
    let noticeTimer = null;
    function showNotice(text, kind) {
      notice.value = { text: <% if i18n_langs %>tmsg(text)<% else %>String(text)<% endif %>, kind: kind || "ok" };
      clearTimeout(noticeTimer);
      noticeTimer = setTimeout(() => { notice.value = null; },
                               kind === "no" ? 6000 : 2500);
    }
    // 登录。界面名「登录」「注册」是约定（gen auth 生成的就叫这两个）：
    // 收到 401 时跳到「登录」，登录成功后回到被打断的那个界面。
    const LOGIN = "登录";
    // 「改密码」也算：登录之后才用得上的账号页，不进导航、不当首页
    const AUTH_SCREENS = [LOGIN, "注册", "改密码"];
    let afterLogin = "";
    // 首页：第一个不是登录页、这个人又看得到的界面（多人模式下教师落在教师端
    // 的第一页，见下面的 visible）。一个都看不到（学生的账号打开了教师端）就是
    // 登录页——退回「第一个界面」的话它也看不到，guardSide 会来回跳
    const firstAppScreen = () =>
      (screens.find(s => !AUTH_SCREENS.includes(s.name) && !hiddenScreen(s.name))
       || screens.find(s => s.name === LOGIN)
       || screens.find(s => !AUTH_SCREENS.includes(s.name)) || screens[0]).name;
    // 把一条记录填进某个界面的表单。列表点「编辑」、按地址参数「载入」
    // 都走这里，类型转换只写一处。
    //
    // 按空白表单里那个字段的类型转：数据库里布尔存成 0/1，而勾选框的
    // v-model 判断勾没勾用的是 String(值) === String(true)——"1" 不等于
    // "true"，不转的话库里置顶的记录显示成没勾，而且不报错。
    function fillForm(screen, record) {
      if (!forms.value[screen]) forms.value[screen] = {};
      const shape = blank[screen] || {};
      for (const [k, v] of Object.entries(record)) {
        forms.value[screen][k] = typeof shape[k] === "boolean"
          ? (v === true || v === 1 || v === "1" || v === "true")
          : v;
      }
    }
    const current = computed(() => screens.find(s => s.name === route.value) || screens[0]);
    // 模板里统一写 form.xxx，指向当前界面那一份。
    const form = computed(() => forms.value[current.value.name] || {});
    // 当前界面的消息流。没有就是没有（空串）：消息弹成底部的提示条。
    //
    // 早先没有流时退回全局第一条流。做题页没有消息流，达标喜报被塞进了
    // 问老师的对话里——做题页上什么都看不见，问老师那边平白多出一条。
    // 别的界面的流不归这个界面管，往里塞什么都是串台。
    const myStream = () => screenStream[current.value.name] || "";
<% if i18n_langs %>
    // —— 界面多语言（可选声明）：项目里有 i18n/<lang>.tsv 才生成这一段。
    // 词典在 web/i18n.<lang>.js（window.I18N），中文原文作键、整串匹配，
    // 查不到的一律回退中文。只翻「提示性文字」：数据值（状态枚举、表格行）
    // 不进词典，路由键（go('学情')）是 JS 字符串，根本不经过 DOM。
    // 语言记在账号上（auth_me 的 lang / POST /account/lang），没登录时记在
    // 浏览器（localStorage；没存过看 navigator.language，以 ja 开头 → 日文——
    // 登录页就用它）。登录后 applyLang 以账号 lang 为准。
    const i18nLang = ref((() => {
      try {
        const saved = localStorage.getItem("zs_i18n");
        if (saved) return saved;
      } catch (e) { /* 存不了就往下走 */ }
      try { if ((navigator.language || "").toLowerCase().startsWith("ja")) return "ja"; } catch (e) { /* 没有 navigator 就中文 */ }
      return "zh";
    })());
    function tmsg(s) {
      const t = String(s == null ? "" : s);
      if (i18nLang.value === "zh") return t;
      return ((window.I18N || {})[i18nLang.value] || {})[t] || t;
    }
    function tdom() {
      if (i18nLang.value === "zh") return;
      const dict = (window.I18N || {})[i18nLang.value] || {};
      const walk = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
      for (let n = walk.nextNode(); n; n = walk.nextNode()) {
<% if has_markdown %>        if (n.parentElement && n.parentElement.closest(".markdown code")) continue;
<% endif %>        const v = n.nodeValue;
        if (!v || !v.trim()) continue;
        const t = dict[v.trim()];
        if (t && t !== v.trim()) n.nodeValue = v.replace(v.trim(), t);
      }
      document.body.querySelectorAll("[placeholder],[title]").forEach(el => {
        for (const a of ["placeholder", "title"]) {
          const v = el.getAttribute(a);
          if (!v || !v.trim()) continue;
          const t = dict[v.trim()];
          if (t && t !== v) el.setAttribute(a, v.replace(v.trim(), t));
        }
      });
    }
    // Vue 重渲染会把替换结果盖回中文（vdom patch）：MutationObserver 兜底
    // 重跑，防抖 120ms；tdom 只改有变化的节点，不会触发自己无限循环。
    let tdomTimer = null;
    function scheduleTdom() {
      if (i18nLang.value === "zh" || tdomTimer) return;
      tdomTimer = setTimeout(() => { tdomTimer = null; tdom(); }, 120);
    }
    function applyLang(lg) {
      lg = lg || "zh";
      if (i18nLang.value !== lg) {
        i18nLang.value = lg;
        try { localStorage.setItem("zs_i18n", lg); } catch (e) { /* 存不了就算了 */ }
      }
      document.documentElement.lang = lg === "zh" ? "zh-CN" : lg;
      if (lg !== "zh") tdom();
    }
    // 顶栏切换：写进账号（POST /account/lang，接口是项目声明的，没有就只切
    // 本地），成功后整页刷新——界面文字、后端消息、<html lang> 一次到位。
    async function switchLang(lg) {
      if (i18nLang.value === lg) return;
      try { localStorage.setItem("zs_i18n", lg); } catch (e) { /* 同上 */ }
      if (me.value.user && typeof endpoints !== "undefined" && endpoints.account_lang) {
        try {
          const r = await postTo(endpoints.account_lang, { action: "account_lang", form: { lang: lg } });
          if (r && r.error) { showNotice(tmsg(r.error), "no"); return; }
        } catch (e) {
          showNotice(tmsg("切换界面语言没成功，请稍后再试"), "no");
          return;
        }
      }
      location.reload();
    }
    Vue.onMounted(() => {
      // 首屏就按该用的语言替换一遍；之后的中文由 MutationObserver 接住
      applyLang(i18nLang.value);
      new MutationObserver(scheduleTdom).observe(document.body,
        { childList: true, subtree: true, characterData: true });
    });
<% endif %>
<% if has_files %>
    // 文件单独放这里，不进 form——form 要能 JSON 深拷贝（payload、snapshot
    // 都靠它），而 File 对象走一遍 JSON 会变成 {}，静默丢失。
    const files = ref({});
    // 存 input 元素，清空时要连 DOM 里的文件名一起抹掉：光清 files 的话
    // 界面上还显示着上次选的文件名，看着像没清干净。
    const fileEls = {};
    function setFileEl(name, el) { if (el) fileEls[name] = el; }

    function pickFile(name, ev, maxsize) {
      const picked = [...(ev.target.files || [])];
      const limit = parseSize(maxsize);
      if (limit) {
        const tooBig = picked.find(f => f.size > limit);
        if (tooBig) {
          // 选完就拦，省得传上去才被拒。这只挡诚实的用户，后端还得再查。
          alert(`${tooBig.name} 超过 ${maxsize}`);
          ev.target.value = "";
          return;
        }
      }
      const box = files.value[current.value.name] || (files.value[current.value.name] = {});
      box[name] = ev.target.multiple ? picked : (picked[0] || null);
    }

    // "5MB" / "500KB" / "1024" -> 字节数。认不出来就当没限制。
    function parseSize(s) {
      if (!s) return 0;
      const m = String(s).trim().match(/^(\d+(?:\.\d+)?)\s*(B|KB|MB|GB)?$/i);
      if (!m) return 0;
      const unit = (m[2] || "B").toUpperCase();
      return Number(m[1]) * ({B:1, KB:1024, MB:1048576, GB:1073741824}[unit] || 1);
    }
<% endif %>
<% if has_overlays %>
    // 当前打开的浮层名，null 表示没有。一次只开一个——真要叠加浮层的话
    // 得改成栈，但那通常是设计出了问题，先不支持。
    //
    // 浮层开关放在地址里：#笔记列表?浮层=笔记&id=5。刷新后还开着（配合
    // 浮层上的「载入」把记录拉回来）、编辑链接能分享、登录完能回到那一条，
    // 浏览器后退键能关浮层——手机上大家就是这么关弹窗的。
    //
    // 早先是反过来的：地址一变就关浮层，浮层本身不进地址。
    const openOverlay = ref(parseHash()[1]["浮层"] || null);
    // keep：打开浮层时，地址里原有的参数留着——审阅页 #教材导入?job=3 上点
    // 「删除这个任务」，确认浮层里的按钮提交时还得知道是哪个任务；关掉浮层也
    // 回到 ?job=3，而不是光秃秃的界面。行上打开的（「带 id」）也一样留着，
    // 这一行的参数盖在上面：学情的学生页 #学情?student=s1 上点一行设定的「编辑」，
    // 地址是 ?student=s1&浮层=…&note_id=5，保存时接口知道是哪个学生的，关掉回到
    // ?student=s1。原来没有参数的界面（#笔记列表）跟以前一样，关掉回到不带参数的。
    let overlayBase = null;
    function showOverlay(name, p, keep) {
      const base = keep ? Object.fromEntries(
        Object.entries(params.value || {}).filter(([k]) => k !== "浮层")) : null;
      overlayBase = base && Object.keys(base).length ? base : null;
      openOverlay.value = name;
      go(route.value, Object.assign({}, overlayBase || {}, { "浮层": name }, p || {}));
    }
    function closeOverlay() {
      openOverlay.value = null;
      const base = overlayBase;
      overlayBase = null;
      if ((params.value || {})["浮层"]) go(route.value, base || undefined);
    }
    // Esc 关掉。浮层里的输入框正在打字时也该响应，所以挂在 window 上。
    window.addEventListener("keydown", (ev) => {
      if (ev.key === "Escape" && openOverlay.value) {
        ev.preventDefault();
        closeOverlay();
      }
    });
    // 地址说了算：后退键把 ?浮层=… 去掉，浮层就关；切到别的界面，地址里
    // 没有浮层参数，也就关了。直接读 parseHash 而不是 params——这个监听器
    // 比更新 params 的那个注册得早，那时 params 还是旧的。
    window.addEventListener("hashchange", () => {
