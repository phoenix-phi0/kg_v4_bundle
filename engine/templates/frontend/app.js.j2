    // 让提示条显示出来——早先 r.json() 直接抛，界面上什么都没有。
    async function afterFetch(r) {
      let data;
      try {
        data = await r.json();
      } catch (e) {
        data = { error: `服务器返回的不是 JSON（${r.status}）` };
