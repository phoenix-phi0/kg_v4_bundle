    function followGo(target) {
      // go：后端让前端换到哪个界面。「@来处」是登录前被打断的那个地址；那页
      // 不是这个人这一端的（学生的页面上被弹去登录、登进来的是教师），就去
      // 本端首页，不提示
      if (target === "@来处") {
        const back = afterLogin;
        afterLogin = "";
        const raw = back.replace(/^#\/?/, "");
        const cut = raw.indexOf("?");
        const name = decodeURIComponent(cut < 0 ? raw : raw.slice(0, cut));
        if (back && !hiddenScreen(name)) location.hash = back;
        else go(firstAppScreen());
        return;
      }
      const resp = { go: target };
      if (resp.go && screens.some(s => s.name === resp.go)) {
        go(resp.go);
      } else if (typeof resp.go === "string" && resp.go.startsWith("#")) {
        // 「#界面?参数」：带着参数换过去（新建导入后跳到这个任务的审阅页
        // #教材导入?job=3）。跟点链接一样走地址，「载入」照常把记录拉回来
        const raw = resp.go.slice(1);
        const cut = raw.indexOf("?");
        const name = decodeURIComponent(cut < 0 ? raw : raw.slice(0, cut));
        if (screens.some(s => s.name === name)) {
          go(name, cut < 0 ? {} : Object.fromEntries(new URLSearchParams(raw.slice(cut + 1))));
        }
