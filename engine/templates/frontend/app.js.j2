    // 先知道是谁，再跑第一个界面的「进入时」（见文件末尾的 onRoute）
    const meReady = refreshMe();
<% else %>
    guardSide();
<% endif %>
    function onSubmit() { console.log("submit", current.value.name, form.value); }
<% if has_endpoints %>
    async function onAction(name) {
