{#- 新建。owner **不从请求里取**，直接写 :current_user（路由器从登录 cookie
    认出来的）。前端就算在请求体里塞一个 owner: 别人，这里也用不到它。 -#}
{% extends "@_base/insert.sql.j2" %}
{% set 插注 = "，归当前用户所有。" %}
{% block insert %}
INSERT INTO {{ e.name }}({% for f in e.fields | 客户端写 | 除去("owner") %}{{ f.name }}, {% endfor %}owner)
VALUES({% for f in e.fields | 客户端写 | 除去("owner") %}{{ f | 转占位符 }}, {% endfor %}:current_user)
{% endblock %}
