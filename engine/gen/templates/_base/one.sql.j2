{#- 按主键查一条。主键排最前，别的列跟着。
    子模板可设 一注（标题后缀）、一排除（额外不查的列名，默认无）、一条件（WHERE 后追加）。 -#}
-- 按主键查一条{{ e | 标签 }}{{ 一注 | default("") }}。
SELECT {{ e | 主键 }}{% for f in e.fields | 可写 | 除去(e | 主键) | 除去(一排除 | default("")) %}, {{ f.name }}{% endfor %}

FROM {{ e.name }}
WHERE {{ e | 主键 }} = :{{ e | 主键 }}{{ 一条件 | default("") }}
