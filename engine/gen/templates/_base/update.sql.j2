{#- 更新。
    SET 里不能有主键：它在 WHERE 里定位，同时又被改的话等于允许改主键，
    而那要级联改所有引用它的表，不是一条 UPDATE 能办的事。
    子模板可设 更新注（标题后缀＋说明整句，默认主键随编辑表单提交）、
    更新排除（SET 里额外不写的列名）、更新条件（WHERE 后追加）。 -#}
-- 更新一条{{ e | 标签 }}{% block note %}。{{ e | 主键 }} 随编辑表单一起提交（列表点编辑时整行拷进去的）。{% endblock %}

UPDATE {{ e.name }} SET
{% for f in e.fields | 客户端写 | 除去(e | 主键) | 除去(更新排除 | default("")) %}
  {{ f | 转赋值 }}{{ "," if not loop.last }}
{% endfor %}
WHERE {{ e | 主键 }} = :{{ e | 主键 }}{{ 更新条件 | default("") }}
